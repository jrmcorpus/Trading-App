# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API Keys (Optional)
VITE_FINNHUB_API_KEY=your-finnhub-key
TWELVE_DATA_API_KEY=your-twelve-data-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
# Optional server-side key for /api/mt4/market-intel (if omitted, Yahoo RSS fallback still works):
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Frontend data-source behavior
VITE_MT4_BRIDGE_URL=/api/mt4
VITE_MT4_ONLY=false
VITE_MT4_CONTRACT_UNITS=1000
VITE_MT4_SYMBOL_SUFFIX=
VITE_MT4_CRYPTO_SUFFIX=
VITE_MT4_SYMBOL_MAP=
# Example map for broker-suffixed symbols:
# VITE_MT4_SYMBOL_MAP={"GBPUSD":"GBPUSDm#","GBPJPY":"GBPJPYm#","GBPNZD":"GBPNZm#","EURJPY":"EURJPYm#","AUDJPY":"AUDJPYm#","US30CASH":"US30Cash#"}
VITE_MT4_ALLOWED_SYMBOLS=
# Optional frontend mirror of MT4 allowed symbols for setup conflict checks:
# VITE_MT4_ALLOWED_SYMBOLS=BTCUSD#,ETHUSD#,SOLUSD#,XRPUSD#,EURUSDm#,USDJPYm#,AUDUSDm#,GBPUSDm#,GBPJPYm#,GBPNZm#,EURJPYm#,AUDJPYm#,US30Cash#,GOLDm#,SILVERm#
VITE_BROKER_WEEK_OPEN_UTC=22:05
VITE_BROKER_WEEK_CLOSE_UTC=21:55
VITE_BROKER_DAILY_BREAK_START_UTC=21:55
VITE_BROKER_DAILY_BREAK_END_UTC=22:05
VITE_AUTO_SESSION_WINDOW_ENABLED=false
VITE_AUTO_SESSION_WINDOW_TZ=Asia/Manila
VITE_AUTO_SESSION_WINDOW_START=20:00
VITE_AUTO_SESSION_WINDOW_END=00:00
VITE_AUTO_SESSION_WINDOW_INCLUDE_CRYPTO=false

# Local Market Bridge (MT4/MT5)
MT5_BRIDGE_PORT=8787
MT5_BRIDGE_PYTHON=python
MT4_BRIDGE_VERSION=2026.03.07-market-intel
MT4_BRIDGE_FILES_DIR=C:\\path\\to\\MT4\\MQL4\\Files
MT4_BRIDGE_FILE_PREFIX=
MT4_BRIDGE_COMMAND_FILE=bridge_command.csv
MT4_BRIDGE_RESULT_FILE=bridge_result.csv
MT4_BRIDGE_POSITIONS_FILE=bridge_positions.csv
MT4_BRIDGE_ACCOUNT_FILE=bridge_account.csv
MT4_BRIDGE_HISTORY_FILE=bridge_history.csv
MT4_BRIDGE_TICKS_FILE=bridge_ticks.csv
MT4_BRIDGE_POLICY_FILE=bridge_policy.csv
MT4_BRIDGE_SYMBOLS_FILE=bridge_symbols.csv

# Guarded trading API limits
MT4_CONFIRM_TTL_MS=60000
MT4_EXEC_TIMEOUT_MS=20000
MT4_MAX_LOT_PER_ORDER=5
MT4_REQUIRE_SL_TP=true
MT4_ALLOWED_SYMBOLS=
# Example allowlist for expanded watchlist:
# MT4_ALLOWED_SYMBOLS=BTCUSD,ETHUSD,SOLUSD,XRPUSD,EURUSD,USDJPY,AUDUSD,GBPUSD,GBPJPY,GBPNZD,EURJPY,AUDJPY,US30CASH,GOLD,SILVER
MT4_MAX_OPEN_TRADES=5
MT4_MAX_OPEN_PER_SYMBOL=1
MT4_MIN_RR=1.5
MT4_SYMBOL_COOLDOWN_SEC=300
MT4_DAILY_LOSS_LIMIT_PCT=3

# App Configuration
VITE_APP_ENV=development
