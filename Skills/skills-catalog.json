      "key_files": [
        "src/components/TradingAssistant.tsx",
        "src/App.tsx",
        "src/components/PriceChart.tsx"
      ],
      "commands": [
        "npm.cmd run type-check"
      ]
    },
    {
      "name": "trade-history-and-policy-reviewer",
      "priority": "P3",
      "purpose": "Interpret trade history, close reasons, tags, policy checks, and audit events.",
      "triggers": [
        "why closed",
        "manual close vs bot close",
        "cooldown started again",
        "history label wrong"
      ],
      "key_files": [
        "src/App.tsx",
        "mt5_bridge/server.mjs",
        "mt5_bridge/headlessTrader.mjs"
      ]
